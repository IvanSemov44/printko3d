# Copy to .env before running `docker compose up`. Values below are for local use only.
POSTGRES_DB=storefront
POSTGRES_USER=storefront
POSTGRES_PASSWORD=change-me-locally

# Product images (decision 0018): an S3-compatible bucket. Leave empty to run without it; only uploading fails then.
# The keys are secrets: put them only in your own .env, never in this file, in the repository or in a chat.
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=
# The public address that the images are read from (decision 0011), for the shop and the panel. For Supabase:
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
IMAGE_BASE_URL=

# Email (decision 0031). Locally the API sends to the Mailpit container; read the messages at http://localhost:8025.
# To use a real provider set all of these in your own .env. An empty EMAIL_HOST turns sending off.
# EMAIL_PASSWORD is a secret: only in your own .env, never in this file or in the repository.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=
# EMAIL_USE_TLS=true

# Published host ports
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
POSTGRES_PORT=5433
API_PORT=8080
STOREFRONT_PORT=5173
ADMIN_PORT=5174

# The public address of the shop, for canonical addresses and /sitemap.xml. Defaults to the local shop address.
SITE_URL=
# Search engines may index the shop only when this is true (production). Leave it empty or false everywhere else.
ALLOW_INDEXING=
