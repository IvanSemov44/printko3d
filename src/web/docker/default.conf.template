server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${API_URL}; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'" always;

    location = /config.json {
        add_header Cache-Control "no-store";
    }

    # Empty for the storefront. For the admin panel it forwards /api/ to the API (written by 40-write-config.sh).
    include /tmp/api-proxy.conf;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
